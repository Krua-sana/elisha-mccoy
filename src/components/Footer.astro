---
const year = new Date().getFullYear();
---

<footer class="bg-panel">
  <div class="mx-auto max-w-[1440px] px-6 py-16 sm:px-8 lg:px-16">
    <div class="grid grid-cols-1 gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <div>
        <p class="font-header text-lg text-ink">ELISHA MCCOY</p>
        <p class="mt-2 text-sm text-body">Makeup Artist</p>
        <p class="mt-4 text-[11px] uppercase tracking-[0.14em] text-subtle">Oxfordshire · UK</p>
        <p class="text-[11px] uppercase tracking-[0.14em] text-subtle">Available for travel</p>
      </div>

      <div>
        <p class="text-xs uppercase tracking-[0.14em] text-subtle">Navigation</p>
        <ul class="mt-4 space-y-3 text-sm">
          <li><a class="text-ink hover:underline" href="/about/">About</a></li>
          <li><a class="text-ink hover:underline" href="/services/">Services</a></li>
          <li><a class="text-ink hover:underline" href="/portfolio/">Portfolio</a></li>
          <li><a class="text-ink hover:underline" href="/contact/">Contact</a></li>
        </ul>
      </div>

      <div>
        <p class="text-xs uppercase tracking-[0.14em] text-subtle">Information</p>
        <ul class="mt-4 space-y-3 text-sm">
          <li><a class="text-ink hover:underline" href="/privacy-policy/">Privacy Policy</a></li>
          <li><a class="text-ink hover:underline" href="/terms/">Terms &amp; Conditions</a></li>
        </ul>
      </div>

      <div>
        <a
          href="/contact/"
          class="inline-flex min-h-11 items-center justify-center rounded-none bg-accent px-6 text-[11px] uppercase tracking-[0.14em] text-onband hover:bg-ink"
        >
          Enquire
        </a>
        <p class="mt-4 text-sm">
          <a class="text-ink hover:underline" href="mailto:hello@elishamccoy.com">hello@elishamccoy.com</a>
        </p>
        <div class="mt-3 flex items-center gap-4">
          <a
            href="https://instagram.com/elishaamccoy"
            rel="noopener"
            aria-label="Elisha McCoy on Instagram"
            class="inline-flex min-h-11 min-w-11 items-center justify-center text-ink hover:text-accent"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
            </svg>
          </a>
          <a
            href="https://tiktok.com/@elishamacs"
            rel="noopener"
            aria-label="Elisha McCoy on TikTok"
            class="inline-flex min-h-11 min-w-11 items-center justify-center text-ink hover:text-accent"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12.53.02C13.84 0 15.14.01 16.44 0c.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"></path>
            </svg>
          </a>
        </div>
      </div>
    </div>

    <hr class="my-10 border-line" />
    <p class="text-center text-[11px] uppercase tracking-[0.14em] text-subtle">
      © {year} Elisha McCoy. All rights reserved.
    </p>
    <p class="mt-2 text-center text-[11px] uppercase tracking-[0.14em] text-subtle">
      Built by <a class="text-link underline hover:text-ink" href="https://all-design.one/" rel="noopener" target="_blank">All-in-One</a> Design Studio
    </p>
  </div>
</footer>
