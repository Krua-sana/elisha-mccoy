---
interface Props {
  href?: string;
  active?: boolean;
  class?: string;
}

const { href, active = false, class: className = "" } = Astro.props;
const Tag = href ? "a" : "button";
---

<Tag
  href={href}
  aria-current={active ? "page" : undefined}
  class:list={[
    "inline-block min-h-11 flex items-center px-1 uppercase text-xs tracking-[0.14em] font-ui pb-1 border-b-2",
    active
      ? "text-ink border-ink"
      : "text-subtle border-transparent hover:text-ink",
    className,
  ]}
>
  <slot />
</Tag>
