---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import { Image } from "astro:assets";

import headerImg from "../assets/photos/makeup-application-detail.png";
import catBridal from "../assets/photos/bridal-veil-portrait.jpeg";
import catGlam from "../assets/photos/glam-sultry-portrait.png";
import catEditorial from "../assets/photos/editorial-dark-profile-portrait.png";
import catSpecialist from "../assets/photos/natural-glam-portrait.jpeg";

const categories = [
  {
    n: "01",
    label: "Bridal & Wedding",
    intro: "Calm, lasting makeup for the whole wedding party — from first look to last dance.",
    enquire: "Enquire about bridal makeup",
    image: catBridal,
    alt: "Bridal makeup by Elisha McCoy, Oxfordshire",
    items: [
      ["Bridal Makeup", "Your full bridal look on the day, applied unhurried wherever you're getting ready."],
      ["Bridal Trial", "A pre-wedding session to test, tweak and agree every detail in advance."],
      ["Luxury Bridal Makeup", "An extended booking with longer wear-testing, lashes and on-the-day touch-up time."],
      ["Bridesmaid Makeup", "Coordinated looks for your party that sit beside yours, never over it."],
      ["Mother of the Bride / Groom", "Polished makeup that photographs well and lasts all day."],
      ["Wedding Guest Makeup", "An elegant look if you're attending rather than getting married."],
      ["Group Makeup Bookings", "Several people at one location, scheduled so everyone is ready on time."],
    ],
  },
  {
    n: "02",
    label: "Glam & Occasion",
    intro: "Event-ready makeup, from barely-there skin to full glamour.",
    enquire: "Enquire about occasion makeup",
    image: catGlam,
    alt: "Evening glam makeup by Elisha McCoy, Oxfordshire",
    items: [
      ["Special Occasion Makeup", "For birthdays, anniversaries, parties and milestone celebrations."],
      ["Soft Glam", "A natural base with subtle definition — enhanced, not made up."],
      ["Full Glam", "Sculpted, high-impact makeup with a flawless base and lashes."],
      ["Evening Glam", "A deeper, longer-wearing look built for low light and late nights."],
      ["Natural Makeup", "Skin-first makeup that just looks like a very good day."],
      ["Prom Makeup", "Photo-ready looks for prom season, tailored to younger skin."],
    ],
  },
  {
    n: "03",
    label: "Editorial & Creative",
    intro: "Makeup built for the camera, the brief and the concept.",
    enquire: "Enquire about editorial work",
    image: catEditorial,
    alt: "Editorial makeup portrait by Elisha McCoy, Oxfordshire",
    items: [
      ["Photoshoot Makeup", "Looks that hold up under both studio and natural light."],
      ["Editorial Makeup", "Concept-led makeup for magazines, lookbooks and campaigns."],
      ["Creative Makeup", "Graphic, artistic and experimental work for shoots and shows."],
      ["Personal Branding Makeup", "Consistent, on-brand looks for headshots and founder photography."],
      ["Content Creator Makeup", "Camera-ready makeup for video, launches and social content."],
    ],
  },
  {
    n: "04",
    label: "Specialist & Consultations",
    intro: "Focused sessions and add-ons, plus one-to-one teaching.",
    enquire: "Enquire about a consultation",
    image: catSpecialist,
    alt: "Natural makeup portrait by Elisha McCoy, Oxfordshire",
    items: [
      ["Mature Skin Makeup", "Techniques and formulas chosen for texture, dryness and fine lines."],
      ["False Lash Application", "Strip or cluster lashes applied on their own or with any look."],
      ["Touch-Up Service", "A return visit during your event to refresh and re-set the look."],
      ["Makeup Change / Second Look", "A full change between a ceremony and party, or day and evening."],
      ["On-Location Makeup", "Travel to your home, venue, hotel or set within the coverage area."],
      ["Makeup Lessons", "A guided session teaching you to recreate your own looks."],
      ["Personal Consultation", "A sit-down to plan a look, a wardrobe of looks or a product edit."],
      ["Makeup Bag Consultation", "A review of what you own, with a shopping list of what's missing."],
    ],
  },
];
---

<BaseLayout
  title="Makeup Services Oxfordshire | Bridal, Editorial & Occasion"
  description="Explore Elisha McCoy's makeup services across Oxfordshire, from luxury bridal and wedding makeup to occasion, prom, editorial, photoshoot and personal branding looks."
>
  <section class="grid grid-cols-1 lg:grid-cols-2">
    <div class="flex flex-col justify-center px-6 py-16 sm:px-10 lg:px-16 lg:py-24">
      <p class="text-xs uppercase tracking-[0.14em] text-subtle">Services</p>
      <h1 class="mt-3">
        <span class="block text-base font-ui font-normal normal-case tracking-normal text-subtle sm:text-lg">
          Bridal, Editorial &amp; Occasion Makeup
        </span>
        <span class="mt-2 block font-header text-3xl text-ink sm:text-4xl">Makeup Services in Oxfordshire</span>
      </h1>
      <p class="mt-6 max-w-lg text-body">
        Explore makeup services across Oxfordshire, from luxury bridal and wedding makeup to occasion, prom, editorial, photoshoot and personal branding looks.
      </p>
      <p class="mt-4 text-xs text-subtle">
        All services are enquiry-led — no public price list, just a bespoke quote for you.
      </p>
    </div>
    <div class="aspect-[4/3] lg:aspect-auto">
      <Image src={headerImg} alt="Makeup application in progress by Elisha McCoy" class="h-full w-full object-cover" widths={[600, 1200]} sizes="(min-width: 1024px) 50vw, 100vw" priority />
    </div>
  </section>

  {categories.map((cat, i) => (
    <section class:list={["px-6 py-16 sm:px-10 lg:px-16 lg:py-20", i % 2 === 1 ? "bg-panel" : ""]}>
      <div class="mx-auto max-w-[1440px]">
        <p class="text-xs uppercase tracking-[0.14em] text-subtle">{cat.n} — {cat.label.toUpperCase()}</p>
        <div class="mt-3 flex flex-wrap items-end justify-between gap-6">
          <h2 class="font-header text-3xl text-ink sm:text-4xl">{cat.label}</h2>
          <Button href="/contact/" variant="text">{cat.enquire} →</Button>
        </div>
        <p class="mt-4 max-w-2xl text-body">{cat.intro}</p>

        <div class="mt-10 grid grid-cols-1 gap-10 lg:grid-cols-[360px_1fr]">
          <div class="aspect-[6/5] overflow-hidden">
            <Image src={cat.image} alt={cat.alt} class="h-full w-full object-cover" widths={[360, 720]} sizes="(min-width: 1024px) 360px, 100vw" />
          </div>
          <div>
            {cat.items.map(([name, desc], idx) => (
              <div class:list={["py-5", idx !== 0 && "border-t border-line"]}>
                <h3 class="font-header text-lg text-ink">{name}</h3>
                <p class="mt-1 text-sm text-body">{desc}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>
  ))}

  <section class="bg-ink px-6 py-20 text-center sm:px-10 lg:px-16 lg:py-28">
    <p class="text-xs uppercase tracking-[0.14em] text-onbandmuted">Enquiries</p>
    <h2 class="mx-auto mt-4 max-w-2xl font-header text-3xl text-onband sm:text-4xl">Tell me what you're planning.</h2>
    <p class="mx-auto mt-4 max-w-xl text-onbandmuted">
      To enquire about any of these services, get in touch — I'll reply with availability and a bespoke quote.
    </p>
    <div class="mt-8">
      <Button href="/contact/" variant="primary">Start an Enquiry</Button>
    </div>
    <p class="mt-6 text-sm">
      <a href="mailto:hello@elishamccoy.com" class="text-onband underline">hello@elishamccoy.com</a>
    </p>
  </section>
</BaseLayout>
