---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Terms & Conditions | Elisha McCoy"
  description="Booking terms and conditions for Elisha McCoy, freelance makeup artist in Oxfordshire."
>
  <section class="mx-auto max-w-3xl px-6 py-16 sm:px-10 lg:py-24">
    <h1 class="font-header text-3xl text-ink">Terms &amp; Conditions</h1>
    <div class="mt-8 space-y-5 text-body">
      <p>A 30% non-refundable deposit secures your date — 50% for bridal bookings.</p>
      <p>Forty-eight hours' notice is required for any changes or cancellations.</p>
      <p>One reschedule is permitted, subject to availability.</p>
      <p>The remaining balance is due on the day of the appointment, or 2–4 weeks before for bridal bookings.</p>
      <p>Late arrival: the full price remains payable and the service may need to be shortened to keep to schedule.</p>
    </div>
  </section>
</BaseLayout>
