---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Privacy Policy | Elisha McCoy"
  description="How Elisha McCoy collects, uses and protects your personal information when you make an enquiry."
>
  <section class="mx-auto max-w-3xl px-6 py-16 sm:px-10 lg:py-24">
    <h1 class="font-header text-3xl text-ink">Privacy Policy</h1>
    <div class="mt-8 space-y-5 text-body">
      <p>
        This is a placeholder Privacy Policy pending a finalised GDPR-compliant policy for the
        contact form, as flagged in the project brief. It should be replaced before launch with a
        policy covering what data is collected via the enquiry form, how it is stored, how long it
        is retained, and how a client can request its deletion.
      </p>
      <p>
        Contact <a class="text-link underline" href="mailto:hello@elishamccoy.com">hello@elishamccoy.com</a>
        with any questions about your data.
      </p>
    </div>
  </section>
</BaseLayout>
