---
import BaseLayout from "../layouts/BaseLayout.astro";
import Input from "../components/Input.astro";
import Textarea from "../components/Textarea.astro";
import Select from "../components/Select.astro";
import Checkbox from "../components/Checkbox.astro";
import Button from "../components/Button.astro";

const eventTypes = [
  "Wedding / Bridal",
  "Special Occasion",
  "Prom",
  "Editorial / Photoshoot",
  "Personal Branding",
  "Consultation / Lesson",
  "Other",
];
---

<BaseLayout
  title="Book a Makeup Artist in Oxfordshire | Elisha McCoy"
  description="Enquire or book Elisha McCoy for bridal, wedding, occasion, editorial and on-location makeup services across Oxfordshire and beyond."
>
  <section class="px-6 pt-16 sm:px-10 lg:px-16 lg:pt-24">
    <p class="text-xs uppercase tracking-[0.14em] text-subtle">Contact</p>
    <h1 class="mt-3">
      
      <span class="mt-2 block font-header text-3xl text-ink sm:text-4xl">Book Your Makeup Appointment</span>
    </h1>
    <p class="mt-6 max-w-2xl font-header text-body">
      Tell me your date, location and what you're planning, and I'll reply with availability and a bespoke, enquiry-led quote — no public price list.
    </p>
  </section>

  <section class="mx-auto grid max-w-[1440px] grid-cols-1 gap-16 px-6 py-16 sm:px-10 lg:grid-cols-[2fr_1fr] lg:px-16 lg:py-20">
    <form
      id="enquiry-form"
      action="https://formsubmit.co/elishamaccoy@gmail.com"
      method="POST"
      novalidate
      class="max-w-2xl space-y-8"
    >
      <input type="hidden" name="_subject" value="New makeup enquiry from elishamccoy.com" />
      <input type="hidden" name="_template" value="table" />
      <input type="hidden" name="_captcha" value="false" />
      <input type="text" name="_honey" tabindex="-1" autocomplete="off" aria-hidden="true" class="hidden" />
      <div>
        <h2 class="font-header text-2xl text-ink">Send an enquiry</h2>
        <p class="mt-2 text-sm text-subtle">Fields marked (required) must be completed.</p>
      </div>

      <Input id="name" label="Full name" required />
      <Input id="email" label="Email address" type="email" required />
      <Select id="event-type" label="Event type" required options={eventTypes} />

      <Input
        id="event-date"
        label="Event date"
        type="date"
        required
        error="Please add an approximate date so I can check availability."
      />

      <Input id="location" label="Location or venue" />
      <div>
        <Input id="people" label="Number of people" type="number" min="1" max="50" step="1" helper="Include yourself. An estimate is fine." />
      </div>

      <Textarea id="message" label="The look you have in mind" helper="Any inspiration, colours or references are welcome." />

      <Checkbox id="consent" required />

      <Button type="submit" variant="primary">Send Enquiry</Button>
      <p id="form-status" role="status" class="sr-only"></p>
    </form>

    <aside class="space-y-8 text-sm">
      <div>
        <p class="text-xs uppercase tracking-[0.14em] text-subtle">What to Include</p>
        <ul class="mt-4 space-y-3 font-header text-body">
          <li>Your event date (approximate is fine)</li>
          <li>The type of event</li>
          <li>How many people need makeup</li>
          <li>Location or venue</li>
          <li>The look you have in mind</li>
        </ul>
      </div>
      <hr class="border-line" />
      <div>
        <p class="text-xs uppercase tracking-[0.14em] text-subtle">Booking Policy</p>
        <ul class="mt-4 space-y-3 font-header text-body">
          <li>A 30% non-refundable deposit secures your date — 50% for bridal.</li>
          <li>Forty-eight hours notice for any changes or cancellations.</li>
          <li>One reschedule permitted, subject to availability.</li>
          <li>Balance is due on the day; 2–4 weeks before for bridal.</li>
        </ul>
      </div>
      <hr class="border-line" />
      <div>
        <p class="text-xs uppercase tracking-[0.14em] text-subtle">Coverage</p>
        <p class="mt-4 font-header text-body">
          Based in Oxford. Oxfordshire and the surrounding counties as standard; national and international travel available for weddings and shoots.
        </p>
      </div>
      <hr class="border-line" />
      <div>
        <p class="text-xs uppercase tracking-[0.14em] text-subtle">Elsewhere</p>
        <ul class="mt-4 space-y-2">
          <li><a class="text-ink underline" href="mailto:elishamaccoy@gmail.com">elishamaccoy@gmail.com</a></li>
          <li><a class="text-ink underline" href="https://instagram.com/elishaamccoy">Instagram — @elishaamccoy</a></li>
          <li><a class="text-ink underline" href="https://tiktok.com/@elishamacs">TikTok — @elishamacs</a></li>
        </ul>
      </div>
    </aside>
  </section>

  <section class="bg-panel px-6 py-16 text-center sm:px-10 lg:px-16 lg:py-20">
    <p class="text-xs uppercase tracking-[0.14em] text-subtle">Travel &amp; Coverage</p>
    <p class="mx-auto mt-4 max-w-2xl font-header text-body">
      Standard coverage is Oxfordshire and the surrounding counties. I travel nationally and internationally for weddings and editorial — just ask.
    </p>
  </section>
</BaseLayout>

<script>
  const form = document.getElementById("enquiry-form") as HTMLFormElement | null;
  const status = document.getElementById("form-status");

  // Don't allow event dates in the past
  const dateInput = document.getElementById("event-date") as HTMLInputElement | null;
  if (dateInput) {
    const now = new Date();
    const pad = (n: number) => String(n).padStart(2, "0");
    dateInput.min = `${now.getFullYear()}-${pad(now.getMonth() + 1)}-${pad(now.getDate())}`;
  }

  const setStatus = (msg: string) => {
    if (!status) return;
    status.textContent = msg;
    status.classList.remove("sr-only");
    status.classList.add("text-sm", "text-body");
  };

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!form.checkValidity()) {
      form.querySelector<HTMLElement>(":invalid")?.focus();
      setStatus("Please check the highlighted fields and try again.");
      return;
    }

    const button = form.querySelector<HTMLButtonElement>("button[type='submit']");
    if (button) button.disabled = true;
    setStatus("Sending your enquiry…");

    const data = new FormData(form);
    const email = data.get("email");
    if (typeof email === "string") data.set("_replyto", email);

    try {
      const res = await fetch("https://formsubmit.co/ajax/elishamaccoy@gmail.com", {
        method: "POST",
        headers: { Accept: "application/json" },
        body: data,
      });
      const json = await res.json().catch(() => ({}));
      const message = String(json.message ?? "");
      if (/activat/i.test(message)) {
        // First-ever submission: FormSubmit emails an activation link to the inbox instead of the enquiry.
        console.warn("FormSubmit:", message);
        setStatus("Form setup: an activation email has been sent to elishamaccoy@gmail.com. Once it's confirmed, enquiries will be delivered.");
        return;
      }
      if (!res.ok || json.success === false || json.success === "false") throw new Error(message);
      setStatus("Thank you — your enquiry has been sent. I'll be in touch soon with availability.");
      form.reset();
    } catch (err) {
      console.error("Enquiry form error:", err);
      setStatus("Sorry, something went wrong sending your enquiry. Please email elishamaccoy@gmail.com directly.");
    } finally {
      if (button) button.disabled = false;
    }
  });
</script>
